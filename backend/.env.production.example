APP_NAME=SmartBiz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartbiz
DB_USERNAME=smartbiz
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=smartbiz_session
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning
MAIL_MAILER=log

# External reminder delivery: configure these locally through deployment secrets.
# Set MAIL_MAILER=smtp and a verified MAIL_FROM_ADDRESS before enabling real mail.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=
