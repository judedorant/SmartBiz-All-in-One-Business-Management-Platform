APP_NAME=SmartBiz
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=UTC
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartbiz
DB_USERNAME=smartbiz
DB_PASSWORD=
DB_SOCKET=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=smartbiz_session
SANCTUM_STATEFUL_DOMAINS=localhost:3000
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@smartbiz.test
MAIL_FROM_NAME=SmartBiz

# External reminder delivery: configure these locally through deployment secrets.
# Set MAIL_MAILER=smtp and a verified MAIL_FROM_ADDRESS before enabling real mail.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Phase 6: server-side Google OAuth credentials, never public frontend variables
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
# Exact, trusted public HTTPS DNS hosts approved for outbound webhooks
SMARTBIZ_WEBHOOK_HOSTS=
